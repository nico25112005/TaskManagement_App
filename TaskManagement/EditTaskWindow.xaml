<Window x:Class="TaskManagement.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagement"
        mc:Ignorable="d"
        Title="Edit task" Height="380" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#ededed">

    <Border Background="#ffffff" Margin="20" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="20">
        <StackPanel>
            <TextBlock Text="Edit task" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="Description" Margin="0,0,0,4" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="Tb_description" Padding="6,4" Margin="0,0,0,12" FontSize="14"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Hours" Margin="0,0,0,4" Foreground="Gray" FontSize="11"/>
                    <TextBox x:Name="Tb_hours" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Importance (1-3)" Margin="0,0,0,4" Foreground="Gray" FontSize="11"/>
                    <TextBox x:Name="Tb_importance" Padding="6,4" FontSize="14"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Delivery date" Margin="0,0,0,4" Foreground="Gray" FontSize="11"/>
            <DatePicker x:Name="Dp_delivery" Margin="0,0,0,16"/>

            <DockPanel LastChildFill="False" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,6" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="Save" Padding="16,6" Background="#509C6E" Foreground="White" FontWeight="SemiBold" Click="Save_Click" IsDefault="True"/>
            </DockPanel>

            <TextBlock x:Name="Lbl_error" Foreground="#e35d48" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
