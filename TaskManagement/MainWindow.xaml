<Window x:Class="TaskManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagement"
        mc:Ignorable="d"
        Title="Task Management" Margin="0,0,0,0" d:DesignWidth="1324" d:DesignHeight="786.96"
        Icon="/Icons/Home_mine.png"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <local:TaskWidthConverter x:Key="TaskWidthConverter"/>

        <Style x:Key="MenuButtons" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="75"/>
        </Style>
        <Style x:Key="Label"  TargetType="Control">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Control" x:Key="Color">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
        </Style>

        <Style TargetType="Control" x:Key="Border" BasedOn="{StaticResource Color}">
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Control" x:Key="Lv_item">
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="15,0"/>
        </Style>

        <!-- Modern global button style -->
        <Style TargetType="Button" x:Key="RoundButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern text input style -->
        <Style TargetType="TextBox" x:Key="RoundTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="17">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DatePicker/ComboBox host style -->
        <Style TargetType="Border" x:Key="RoundInputBorder">
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern label value display -->
        <Style TargetType="Label" x:Key="RoundValueLabel" BasedOn="{StaticResource Label}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style TargetType="Border" x:Key="HeaderBorder" BasedOn="{StaticResource CardBorder}">
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ListView" x:Key="RoundListView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#969696"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <ControlTemplate x:Key="ButtonTemplate1" TargetType="{x:Type ButtonBase}">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Button.IsDefaulted" Value="true">
                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="true">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>



    </Window.Resources>

    <Grid Background="#f3f3f3">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Background="#ffffff">


        </DockPanel>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ffffff" BorderBrush="#969696" BorderThickness="0,0,1,0" CornerRadius="0,10,10,0" Margin="4,5,0,5">
                <StackPanel>
                <Button Template="{DynamicResource ButtonTemplate1}" Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Margin="10,20,10,0" Click="Home_page">
                    <StackPanel>
                        <Image Source="/Icons/Home_mine.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Home" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Todo_page">
                    <StackPanel>
                        <Image Source="/icons/Tasks.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="To-do" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Plan_page">
                    <StackPanel>
                        <Image Source="/icons/Todo.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Plan" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Settings_page">
                    <StackPanel>
                        <Image Source="/icons/Settings.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Settings" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Button>
            </StackPanel>
        </Border>

            <!--Home-->
            <Grid Grid.Column="1" x:Name="Home" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--Left Side-->
                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Grid.Row="0" Padding="10">
                        <StackPanel>
                            <Label Style="{StaticResource Label}" x:Name="Timer_Label" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,1,1,0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="Timer">
                            </Label>
                            <Label x:Name="TimerDisplay" Style="{StaticResource RoundValueLabel}" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,0,1,0" Height="60" Content="00:00" FontSize="30">
                            </Label>
                            <Label x:Name="TimerState" Style="{StaticResource RoundValueLabel}" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,0,1,1" Height="22" Content="Ready" FontSize="11" Foreground="Gray">
                            </Label>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,8,0,0">
                                <Button x:Name="BtnTimerStart" Style="{StaticResource RoundButton}" Content="Start" Height="40" Width="80" Margin="20,4,4,4" DockPanel.Dock="Left" Click="Timer_Start"/>
                                <Button x:Name="BtnTimerPause" Style="{StaticResource RoundButton}" Content="Pause" Height="40" Width="80" Margin="4" DockPanel.Dock="Left" Click="Timer_Pause" IsEnabled="False"/>
                                <Button x:Name="BtnTimerStop" Style="{StaticResource RoundButton}" Content="Stop" Height="40" Width="80" Margin="4" DockPanel.Dock="Left" Click="Timer_Stop" IsEnabled="False"/>
                                <Button x:Name="BtnTimerSkip" Style="{StaticResource RoundButton}" Content="Skip break" Height="40" Width="80" Margin="4,4,20,4" DockPanel.Dock="Left" Click="Timer_SkipBreak" IsEnabled="False"/>
                            </DockPanel>
                            <TextBlock x:Name="Lbl_focusStats" HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,4,0,0" Text="Loading focus stats..."/>
                        </StackPanel>
                    </Border>


                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0,10,0,0" Padding="10">
                        <DockPanel>
                            <Label Style="{StaticResource Label}" x:Name="Todo_Label" Content="To-do" BorderBrush="#969696" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" >
                            </Label>
                            <Label x:Name="TodoLoadLabel" Style="{StaticResource Label}" BorderBrush="#969696" BorderThickness="0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" FontSize="11" Padding="0,0,0,4" Content=""/>

                            <!-- Today section -->
                            <Label Style="{StaticResource Label}" x:Name="TodayHeader" Content="Today" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12">
                            </Label>
                            <ListView Style="{StaticResource RoundListView}" BorderThickness="1,0,1,1" x:Name="Lv_TodayTodos" DockPanel.Dock="Top" MaxHeight="240" Visibility="Collapsed">

                                <ListView.ItemTemplate >
                                    <DataTemplate>
                                        <Border BorderBrush="#969696" BorderThickness="1" CornerRadius="10" Padding="6,4" Margin="4,2" Background="White">
                                            <DockPanel>
                                                <Label Content="{Binding Description}" FontWeight="SemiBold" FontSize="12" Padding="0"/>
                                                <Label Content="{Binding Hours, StringFormat={}{0:F1}h}" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Padding="4,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>
                            <TextBlock x:Name="Tb_TodayEmpty" DockPanel.Dock="Top" Text="Nothing on your plate for today." FontSize="12" Foreground="Gray" Margin="12,8,12,8" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <!-- Upcoming section -->
                            <Label Style="{StaticResource Label}" Content="Upcoming" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0">
                            </Label>
                            <ListView Style="{StaticResource RoundListView}" BorderThickness="1,0,1,1" x:Name="Lv_UpcomingTodos" DockPanel.Dock="Top" Visibility="Collapsed">

                                <ListView.ItemTemplate >
                                    <DataTemplate>
                                        <Border BorderBrush="#969696" BorderThickness="1" CornerRadius="10" Padding="6,4" Margin="4,2" Background="White">
                                            <DockPanel>
                                                <Label Content="{Binding Description}" FontSize="12" Padding="0"/>
                                                <Label Content="{Binding Hours, StringFormat={}{0:F1}h}" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Padding="4,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>
                            <TextBlock x:Name="Tb_UpcomingEmpty" DockPanel.Dock="Top" Text="No upcoming tasks. You're either all caught up or no delivery dates are set." FontSize="12" Foreground="Gray" Margin="12,8,12,8" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <!-- Recently done section -->
                            <Label Style="{StaticResource Label}" Content="Recently done" DockPanel.Dock="Top" BorderBrush="#969696" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" Foreground="#509C6E">
                            </Label>
                            <ListView Style="{StaticResource RoundListView}" BorderThickness="1,0,1,1" x:Name="Lv_DoneTodos" DockPanel.Dock="Top" MaxHeight="160">

                                <ListView.ItemTemplate >
                                    <DataTemplate>
                                        <Border BorderBrush="#969696" BorderThickness="1" CornerRadius="10" Padding="6,4" Margin="4,2" Background="White">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="↶ Undo" Padding="6,2" Margin="8,0,0,0" FontSize="10" Click="UndoDoneTodo_Click" Tag="{Binding}" Background="Transparent" BorderBrush="#969696" Style="{StaticResource RoundButton}"/>
                                                <Label DockPanel.Dock="Right" Content="{Binding DoneAtLabel}" FontSize="10" Foreground="Gray" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Padding="0" TextDecorations="Strikethrough" Foreground="Gray" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>

                        </DockPanel>
                    </Border>

                </Grid>

                <!--Right Side-->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0" Margin="0,0,0,10" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                                <Button Style="{StaticResource RoundButton}" Content="Redistribute" Padding="10,2" Margin="4,2" DockPanel.Dock="Right" Click="Redistribute_Click" ToolTip="Re-run task distribution (respects current CalendarEvents)"/>
                                <Label Style="{StaticResource Label}" x:Name="Termine_Label" Content="Termine" BorderBrush="#969696" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" >
                                </Label>
                            </DockPanel>
                            <ListView x:Name="Lv_WeekPlan" Style="{StaticResource RoundListView}" BorderThickness="1,0,1,1">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#969696" BorderThickness="1" CornerRadius="10" Padding="5" Margin="10,3,0,3" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="5*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tagesbezeichnung -->
                                                <Label Content="{Binding Day}" Grid.Column="0" FontWeight="Bold"/>

                                                <!-- Task-Zeitleistenbereich (drop target for dragged tasks) -->
                                                <StackPanel x:Name="DayTaskContainer" Grid.Column="1"
                                                            AllowDrop="True"
                                                            Background="Transparent"
                                                            Drop="DayTaskContainer_Drop"
                                                            DragEnter="DayTaskContainer_DragEnter"
                                                            DragLeave="DayTaskContainer_DragLeave"
                                                            DragOver="DayTaskContainer_DragOver"
                                                            Tag="{Binding}">
                                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" Height="30" CornerRadius="8" Margin="5,3"
                                                                        BorderBrush="#969696" BorderThickness="1"
                                                                        MouseLeftButtonDown="TaskChip_MouseLeftButtonDown"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Taskbeschreibung -->
                                                                        <Label Content="{Binding Description}" Grid.Column="0" Margin="5,0" FontWeight="Bold"/>

                                                                        <!-- Zeitleiste basierend auf Task-Dauer (max-width ~250) -->
                                                                        <Rectangle Grid.Column="1" Fill="#00d1ff" Margin="5,0" Height="15"
                                                                                   Width="{Binding Hours, Converter={StaticResource TaskWidthConverter}, ConverterParameter=10}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>


                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0,10,0,0" Padding="10">
                        <DockPanel>
                            <Label Style="{StaticResource Label}" x:Name="Fertig_Label" Content="Fertig" BorderBrush="#969696" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" >
                            </Label>

                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <ListView Grid.Row="0" Style="{StaticResource RoundListView}" BorderThickness="1,0,1,1">


                                </ListView>

                                <ListView Grid.Column="1"  Grid.Row="0" Style="{StaticResource RoundListView}" BorderThickness="0,0,1,1">

                                </ListView>

                            </Grid>


                        </DockPanel>
                    </Border>


                </Grid>
            </Grid>
            <!--Todo Page-->
            <Grid Grid.Column="1" x:Name="Todo" Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>


                <Border Style="{StaticResource CardBorder}" Margin="10" Background="White" Grid.Column="0" Padding="10">
                    <StackPanel KeyDown="CreateForm_KeyDown">

                        <Label Style="{StaticResource Color}" x:Name="Description_Label" Margin="10,20,10,2" Content="Description"/>



                        <TextBox Style="{StaticResource RoundTextBox}" Margin="10,0,10,5" Text="" x:Name="Tb_description"/>

                        <Label Style="{StaticResource Color}" x:Name="Hours_Label" Margin="10,15,10,2" Content="Hours"/>


                        <TextBox Style="{StaticResource RoundTextBox}" Margin="10,0,10,5" Text="" x:Name="Tb_hours"/>


                        <Label Style="{StaticResource Color}" x:Name="DeliveryDate_Label" Margin="10,15,10,2" Content="Delivery Date"/>


                        <Border Style="{StaticResource RoundInputBorder}" Margin="10,0,10,5" Padding="1">
                            <DatePicker x:Name="Dp_delivery_date" Background="White" BorderBrush="#969696" BorderThickness="1" Padding="4"/>
                        </Border>


                        <Label Style="{StaticResource Color}" x:Name="Importancy_Label" Margin="10,15,10,2" Content="Importancy"/>


                        <TextBox Style="{StaticResource RoundTextBox}" Margin="10,0,10,5" x:Name="Tb_importancy"/>


                        <Button Style="{StaticResource RoundButton}" HorizontalAlignment="Center" Padding="20,2" Margin="0,20,0,5" Content="Create" Click="Create"/>
                    </StackPanel>
                </Border>


                <StackPanel Grid.Column="1" Margin="10">
                    <!-- Filter / Sort toolbar -->
                    <Border Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="Cb_todoSort" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Cb_todoSort_SelectionChanged" Background="White" BorderBrush="#969696" BorderThickness="1">
                                <ComboBoxItem Content="Sort: Due date"/>
                                <ComboBoxItem Content="Sort: Importance"/>
                                <ComboBoxItem Content="Sort: Hours"/>
                                <ComboBoxItem Content="Sort: Description"/>
                            </ComboBox>
                            <TextBox x:Name="Tb_todoFilter" Style="{StaticResource RoundTextBox}" DockPanel.Dock="Left" Width="200" TextChanged="Tb_todoFilter_TextChanged" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ListView Margin="0" d:ItemsSource="{d:SampleData ItemCount=5}" Style="{StaticResource RoundListView}" BorderThickness="0" x:Name="Lv_Todos" MouseDoubleClick="Lv_Todos_MouseDoubleClick" Visibility="Collapsed">

                        <ListView.ItemTemplate >
                            <DataTemplate>
                                <Border BorderBrush="#969696" BorderThickness="1" CornerRadius="10" Padding="5" Margin="10,3,0,3" Background="#ffffff">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label Content="Description:" Margin="15,0" Grid.Column="0" Grid.Row="0" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                                        <Label Content="Delivery Date:" Margin="15,0" Grid.Column="1" Grid.Row="0" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                                        <Label Content="Importance:" Margin="15,0" Grid.Column="2" Grid.Row="0" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                                        <Label Content="Hours:" Margin="15,0" Grid.Column="3" Grid.Row="0" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                                        <Label Content="Weighting:" Margin="15,0" Grid.Column="4" Grid.Row="0" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>

                                        <Label Content="{Binding Description}" Style="{StaticResource Lv_item}" Grid.Column="0" Grid.Row="1" FontSize="12" Background="White">
                                        </Label>
                                        <Label Content="{Binding Delivery, StringFormat='{}{0:dd.MM.yyyy}'}" Style="{StaticResource Lv_item}" Grid.Column="1" Grid.Row="1" FontSize="12" Background="White">
                                        </Label>
                                        <Label Content="{Binding Importance}" Style="{StaticResource Lv_item}" Grid.Column="2" Grid.Row="1" FontSize="12" Background="White">
                                        </Label>
                                        <Label Content="{Binding Hours}" Style="{StaticResource Lv_item}" Grid.Column="3" Grid.Row="1" FontSize="12" Background="White">
                                        </Label>
                                        <Label Content="{Binding AllocationWeighting, StringFormat='{}{0:F0}'}" Style="{StaticResource Lv_item}" Grid.Column="4" Grid.Row="1" FontSize="12" Background="White">
                                        </Label>
                                        <Button Content="✕" Grid.Column="5" Grid.Row="0" Grid.RowSpan="2" Width="24" Height="24" Margin="4,0,0,0" VerticalAlignment="Center" Background="#e35d48" Foreground="White" BorderThickness="0" Click="DeleteTodo_Click" Tag="{Binding}" FontSize="12">
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>


                    </ListView>
                </StackPanel>
                <TextBlock x:Name="Tb_TodoEmpty" Grid.Column="1" Margin="10" Text="No tasks yet. Create your first one above or press Ctrl+Shift+N." FontSize="14" Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Visibility="Visible"/>

            </Grid>
            <!--Plan (Calendar / fixed events + free time blocks)-->
            <Grid Grid.Column="1" x:Name="Plan" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}" Grid.Row="0" Margin="10,6,10,0" Padding="6">
                    <!-- Date navigation bar -->
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Content="◀" Padding="8,2" Margin="0,0,8,0" Click="PlanPrevWeek_Click"/>
                        <TextBlock x:Name="Tb_PlanWeekLabel" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" Text="Week of 03.09.2026 – 09.09.2026"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Content="▶" Padding="8,2" Margin="0,0,8,0" Click="PlanNextWeek_Click"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Content="Today" Padding="8,2" Margin="0,0,0,0" Click="PlanToday_Click"/>
                    </DockPanel>
                </Border>

                <!-- Toolbar: add event of currently selected type -->
                <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="10" Padding="6">
                    <DockPanel LastChildFill="False">
                        <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Type:" VerticalAlignment="Center" Margin="0,0,8,0" BorderThickness="0"/>
                        <Border Style="{StaticResource RoundInputBorder}" DockPanel.Dock="Left" Padding="1">
                            <ComboBox x:Name="Cb_eventType" Width="180" SelectedIndex="0" VerticalAlignment="Center" Background="White" BorderBrush="#969696" BorderThickness="1" SelectionChanged="Cb_eventType_SelectionChanged">
                                <ComboBoxItem Content="Fixed appointment"/>
                                <ComboBoxItem Content="Work hours (for tasks)"/>
                                <ComboBoxItem Content="Free time (no tasks)"/>
                                <ComboBoxItem Content="Sleep"/>
                            </ComboBox>
                        </Border>

                        <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Title:" VerticalAlignment="Center" Margin="16,0,8,0" BorderThickness="0"/>
                        <TextBox x:Name="Tb_eventTitle" Style="{StaticResource RoundTextBox}" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center"/>

                        <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Day:" VerticalAlignment="Center" Margin="16,0,8,0" BorderThickness="0"/>
                        <Border Style="{StaticResource RoundInputBorder}" DockPanel.Dock="Left" Padding="1">
                            <DatePicker x:Name="Dp_eventDay" VerticalAlignment="Center" Width="140" Background="White" BorderBrush="#969696" BorderThickness="1"/>
                        </Border>

                        <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="From:" VerticalAlignment="Center" Margin="16,0,8,0" BorderThickness="0"/>
                        <Border Style="{StaticResource RoundInputBorder}" DockPanel.Dock="Left" Padding="1">
                            <ComboBox x:Name="Cb_eventStart" Width="80" VerticalAlignment="Center" Background="White" BorderBrush="#969696" BorderThickness="1"/>
                        </Border>
                        <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="To:" VerticalAlignment="Center" Margin="8,0,8,0" BorderThickness="0"/>
                        <Border Style="{StaticResource RoundInputBorder}" DockPanel.Dock="Left" Padding="1">
                            <ComboBox x:Name="Cb_eventEnd" Width="80" VerticalAlignment="Center" Background="White" BorderBrush="#969696" BorderThickness="1"/>
                        </Border>

                        <Button Style="{StaticResource RoundButton}" DockPanel.Dock="Right" Content="Add event" Padding="14,4" Margin="10,0,0,0" Click="AddCalendarEvent"/>
                    </DockPanel>
                </Border>

                <!-- Week overview: 7 columns, one per day -->
                <Border Style="{StaticResource CardBorder}" Grid.Row="2" Margin="10" Padding="10">
                    <Grid x:Name="PlanCalendarGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Day headers + content generated in code-behind.
                             See RefreshPlanView(). -->
                    </Grid>
                </Border>
            </Grid>

            <!--Settings-->
            <Grid Grid.Column="1" x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Personalize the planner and timer to match how you actually work." Foreground="Gray" FontSize="12" Margin="0,0,0,20"/>

                        <!-- Planner section -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Planner" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                                <TextBlock Text="How many hours per day are realistic, and how far ahead should the planner look?" Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

                                <TextBlock Text="Max hours per day" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_maxHours" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="3.5h" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_maxHours" Minimum="0.5" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Sl_maxHours_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Plan horizon (days)" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_planableDays" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="10d" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_planableDays" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_planableDays_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Work-day boundaries" Margin="0,0,0,4"/>
                                <TextBlock Text="Tasks are placed only inside this window unless you mark time as Free/Sleep elsewhere." Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Start" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="Cb_workStart" SelectionChanged="Cb_workHours_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="End" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="Cb_workEnd" SelectionChanged="Cb_workHours_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Focus / Timer section -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Focus timer" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                                <TextBlock Text="Length of one focus block, breaks, and when to take a long one." Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

                                <TextBlock Text="Focus block length" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_focusMin" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="50min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_focusMin" Minimum="15" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Sl_focusMin_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Short break" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_shortBreak" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="5min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_shortBreak" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_shortBreak_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Long break" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_longBreak" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="15min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_longBreak" Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_longBreak_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Long break every Nth block" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_blocksBeforeLong" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="3" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_blocksBeforeLong" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_blocksBeforeLong_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Appearance section -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock Text="Dark mode" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="Tg_darkMode" DockPanel.Dock="Right" Content="Off" Width="60" Checked="Tg_darkMode_Changed" Unchecked="Tg_darkMode_Changed"/>
                                </DockPanel>
                                <TextBlock Text="(Not yet implemented in this build — coming soon.)" Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Border>

                        <!-- Data section -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Data" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                    <TextBlock Text="Save location" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="Open folder" Padding="12,4" Click="OpenDataFolder_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="Lbl_dataPath" Text="..." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock Text="Export all data (JSON)" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="Export" Padding="12,4" Click="ExportData_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="Lbl_exportStatus" Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="About" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock Text="Task Management — A planner that respects your calendar and your time." Margin="0,0,0,4"/>
                                <TextBlock x:Name="Lbl_version" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink x:Name="Link_github" NavigateUri="https://github.com/nico25112005/TaskManagement_App" RequestNavigate="Link_github_RequestNavigate">
                                        github.com/nico25112005/TaskManagement_App
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar: always visible, shows live counts -->
        <Border Grid.Row="2" Background="#ffffff" BorderBrush="#969696" BorderThickness="0,1,0,0" Padding="10,4"
                CornerRadius="10,10,0,0"
                x:Name="StatusBar">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" x:Name="Status_OpenTasks" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="Status_TodayHours" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="Status_FocusBlocks" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock x:Name="Status_Message" VerticalAlignment="Center" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
