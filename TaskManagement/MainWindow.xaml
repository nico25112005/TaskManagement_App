<Window x:Class="TaskManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagement"
        mc:Ignorable="d"
        Title="Task Management" Margin="0,0,0,0" d:DesignWidth="1324" d:DesignHeight="786.96"
        Icon="/Icons/Home_mine.png"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <local:TaskWidthConverter x:Key="TaskWidthConverter"/>

        <Style x:Key="MenuButtons" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="75"/>
        </Style>
        <Style x:Key="Label"  TargetType="Control">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Control" x:Key="Color">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
        </Style>

        <Style TargetType="Control" x:Key="Border" BasedOn="{StaticResource Color}">
            <Setter Property="BorderBrush" Value="#abadb3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Control" x:Key="Lv_item">
            <Setter Property="BorderBrush" Value="#abadb3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="15,0"/>
        </Style>
        
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <ControlTemplate x:Key="ButtonTemplate1" TargetType="{x:Type ButtonBase}">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Button.IsDefaulted" Value="true">
                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="true">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        
        
    </Window.Resources>
    
    <Grid Background="#ededed">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Background="#ffffff">


        </DockPanel>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#ffffff">
                <Button Template="{DynamicResource ButtonTemplate1}" Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Margin="10,20,10,0" Click="Home_page">
                    <StackPanel>
                        <Image Source="/Icons/Home_mine.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Home" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </Button.Resources>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Todo_page">
                    <StackPanel>
                        <Image Source="/icons/Tasks.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="To-do" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </Button.Resources>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Plan_page">
                    <StackPanel>
                        <Image Source="/icons/Todo.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Plan" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </Button.Resources>

                </Button>

                <Button Style="{StaticResource MenuButtons}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5" Click="Settings_page">
                    <StackPanel>
                        <Image Source="/icons/Settings.png" Height="35" Width="35" Stretch="Uniform"/>
                        <Label Style="{StaticResource Label}" Background="Transparent" Content="Settings" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </Button.Resources>

                </Button>
            </StackPanel>

            <!--Home-->
            <Grid Grid.Column="1" x:Name="Home" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <!--Left Side-->
                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10" Grid.Row="0">

                        <Label Style="{StaticResource Label}" x:Name="Timer_Label" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,1,1,1" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="Timer"/>
                        <Label x:Name="TimerDisplay" Style="{StaticResource Label}" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,0,1,0" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Content="00:00" FontSize="30"/>
                        <Label x:Name="TimerState" Style="{StaticResource Label}" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,0,1,0" Height="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Ready" FontSize="11" Foreground="Gray"/>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <Button x:Name="BtnTimerStart" Style="{StaticResource Label}" Content="Start" Height="40" Width="80" Margin="20,4,4,4" DockPanel.Dock="Left" Click="Timer_Start"/>
                            <Button x:Name="BtnTimerPause" Style="{StaticResource Label}" Content="Pause" Height="40" Width="80" Margin="4" DockPanel.Dock="Left" Click="Timer_Pause" IsEnabled="False"/>
                            <Button x:Name="BtnTimerStop" Style="{StaticResource Label}" Content="Stop" Height="40" Width="80" Margin="4" DockPanel.Dock="Left" Click="Timer_Stop" IsEnabled="False"/>
                            <Button x:Name="BtnTimerSkip" Style="{StaticResource Label}" Content="Skip break" Height="40" Width="80" Margin="4,4,20,4" DockPanel.Dock="Left" Click="Timer_SkipBreak" IsEnabled="False"/>
                        </DockPanel>
                        <TextBlock x:Name="Lbl_focusStats" HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,4,0,0" Text="Loading focus stats..."/>

                    </StackPanel>


                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <Label Style="{StaticResource Label}" x:Name="Todo_Label" Content="To-do" BorderBrush="#abadb3" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" />
                        <Label x:Name="TodoLoadLabel" Style="{StaticResource Label}" BorderBrush="#abadb3" BorderThickness="0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" FontSize="11" Padding="0,0,0,4" Content=""/>

                        <!-- Today section -->
                        <Label Style="{StaticResource Label}" x:Name="TodayHeader" Content="Today" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12"/>
                        <ListView BorderThickness="1,0,1,1" x:Name="Lv_TodayTodos" DockPanel.Dock="Top" MaxHeight="240">

                            <ListView.ItemTemplate >
                                <DataTemplate>
                                    <Border BorderBrush="#C9C9C9" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="4,2" Background="#FFFCF1D9">
                                        <DockPanel>
                                            <Label Content="{Binding Description}" FontWeight="SemiBold" FontSize="12" Padding="0"/>
                                            <Label Content="{Binding Hours, StringFormat={}{0:F1}h}" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Padding="4,0,0,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <!-- Upcoming section -->
                        <Label Style="{StaticResource Label}" Content="Upcoming" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                        <ListView BorderThickness="1,0,1,1" x:Name="Lv_UpcomingTodos" DockPanel.Dock="Top">

                            <ListView.ItemTemplate >
                                <DataTemplate>
                                    <Border BorderBrush="#C9C9C9" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="4,2">
                                        <DockPanel>
                                            <Label Content="{Binding Description}" FontSize="12" Padding="0"/>
                                            <Label Content="{Binding Hours, StringFormat={}{0:F1}h}" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Padding="4,0,0,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <!-- Recently done section -->
                        <Label Style="{StaticResource Label}" Content="Recently done" DockPanel.Dock="Top" BorderBrush="#abadb3" BorderThickness="1,0,1,0" Padding="6,4" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" Foreground="#509C6E"/>
                        <ListView BorderThickness="1,0,1,1" x:Name="Lv_DoneTodos" DockPanel.Dock="Top" MaxHeight="160">

                            <ListView.ItemTemplate >
                                <DataTemplate>
                                    <Border BorderBrush="#C9C9C9" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="4,2" Background="#f3faf5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="↶ Undo" Padding="6,2" Margin="8,0,0,0" FontSize="10" Click="UndoDoneTodo_Click" Tag="{Binding}" Background="Transparent" BorderBrush="#abadb3"/>
                                            <Label DockPanel.Dock="Right" Content="{Binding DoneAtLabel}" FontSize="10" Foreground="Gray" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                            <Label Content="{Binding Description}" FontSize="12" Padding="0" TextDecorations="Strikethrough" Foreground="Gray"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </DockPanel>

                </Grid>
                
                <!--Right Side-->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                            <Button Style="{StaticResource Border}" Content="Redistribute" Padding="10,2" Margin="4,2" DockPanel.Dock="Right" Click="Redistribute_Click" ToolTip="Re-run task distribution (respects current CalendarEvents)"/>
                            <Label Style="{StaticResource Label}" x:Name="Termine_Label" Content="Termine" BorderBrush="#abadb3" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" />
                        </DockPanel>
                        <ListView x:Name="Lv_WeekPlan" BorderThickness="1,0,1,1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#C9C9C9" BorderThickness="1.5" CornerRadius="2" Padding="5" Margin="10,3,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="5*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tagesbezeichnung -->
                                            <Label Content="{Binding Day}" Grid.Column="0" FontWeight="Bold"/>

                                            <!-- Task-Zeitleistenbereich (drop target for dragged tasks) -->
                                            <StackPanel x:Name="DayTaskContainer" Grid.Column="1"
                                                        AllowDrop="True"
                                                        Background="Transparent"
                                                        Drop="DayTaskContainer_Drop"
                                                        DragEnter="DayTaskContainer_DragEnter"
                                                        DragLeave="DayTaskContainer_DragLeave"
                                                        DragOver="DayTaskContainer_DragOver"
                                                        Tag="{Binding}">
                                                <ItemsControl ItemsSource="{Binding Tasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#E1E1E1" Height="30" CornerRadius="5" Margin="5,3"
                                                                    MouseLeftButtonDown="TaskChip_MouseLeftButtonDown"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Taskbeschreibung -->
                                                                    <Label Content="{Binding Description}" Grid.Column="0" Margin="5,0" FontWeight="Bold"/>

                                                                    <!-- Zeitleiste basierend auf Task-Dauer (max-width ~250) -->
                                                                    <Rectangle Grid.Column="1" Fill="LightGreen" Margin="5,0" Height="15"
                                                                               Width="{Binding Hours, Converter={StaticResource TaskWidthConverter}, ConverterParameter=10}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>


                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <Label Style="{StaticResource Label}" x:Name="Fertig_Label" Content="Fertig" BorderBrush="#abadb3" BorderThickness="1,1,1,0" HorizontalContentAlignment="Center" DockPanel.Dock="Top" />

                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <ListView Grid.Row="0" BorderThickness="1,0,1,1">

                            
                            </ListView>
                        
                            <ListView Grid.Column="1"  Grid.Row="0" BorderThickness="0,0,1,1">

                            </ListView>
                            
                        </Grid>
                        

                    </DockPanel>


                </Grid>
            </Grid>
            <!--Todo Page-->
            <Grid Grid.Column="1" x:Name="Todo" Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Margin="10" Background="White" Grid.Column="0" KeyDown="CreateForm_KeyDown">

                    <Label Style="{StaticResource Color}" x:Name="Description_Label" Margin="10,20,10,2" Content="Description"/>



                    <TextBox Style="{StaticResource Border}" Margin="10,0,10,5" Text="" x:Name="Tb_description">
                            
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>

                    </TextBox>

                    <Label Style="{StaticResource Color}" x:Name="Hours_Label" Margin="10,15,10,2" Content="Hours"/>


                    <TextBox Style="{StaticResource Border}" Margin="10,0,10,5" Text="" x:Name="Tb_hours">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>

                    </TextBox>


                    <Label Style="{StaticResource Color}" x:Name="DeliveryDate_Label" Margin="10,15,10,2" Content="Delivery Date"/>


                    <DatePicker Style="{StaticResource Border}" Margin="10,0,10,5" x:Name="Dp_delivery_date">
                            
                            <DatePicker.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </DatePicker.Resources>

                    </DatePicker>


                    <Label Style="{StaticResource Color}" x:Name="Importancy_Label" Margin="10,15,10,2" Content="Importancy"/>


                    <TextBox Style="{StaticResource Border}" Margin="10,0,10,5" x:Name="Tb_importancy">

                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>

                    </TextBox>

                        <Button Style="{StaticResource Border}" HorizontalAlignment="Center" Padding="20,2" Margin="0,20,0,5" Content="Create" Click="Create">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>


                <ListView Grid.Column="1" Margin="10" d:ItemsSource="{d:SampleData ItemCount=5}" Style="{StaticResource Color}" BorderThickness="0" x:Name="Lv_Todos" MouseDoubleClick="Lv_Todos_MouseDoubleClick">

                        <ListView.ItemTemplate >
                            <DataTemplate>
                                <DockPanel Margin="4,3">
                                    <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2" Margin="8,0,0,0" Click="DeleteTodo_Click" Tag="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Content="✓ Done" Padding="8,2" Margin="4,0,0,0" Click="MarkTodoDone_Click" Tag="{Binding}" Background="#509C6E" Foreground="White"/>
                                    <Label DockPanel.Dock="Right" Content="{Binding Hours, StringFormat={}{0:F1}h}" FontSize="11" Foreground="Gray" Padding="0" VerticalContentAlignment="Center"/>
                                    <Label DockPanel.Dock="Right" Content="{Binding Delivery, StringFormat='due {0:dd.MM.}'}" FontSize="11" Foreground="Gray" Margin="8,0" Padding="0" VerticalContentAlignment="Center"/>
                                    <Label Content="{Binding Description}" VerticalContentAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>


                    </ListView>
                
            </Grid>
            <!--Plan (Calendar / fixed events + free time blocks)-->
            <Grid Grid.Column="1" x:Name="Plan" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Date navigation bar -->
                <DockPanel Grid.Row="0" Margin="10,6,10,0" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="◀" Padding="8,2" Margin="0,0,8,0" Click="PlanPrevWeek_Click"/>
                    <TextBlock x:Name="Tb_PlanWeekLabel" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" Text="Week of 03.09.2026 – 09.09.2026"/>
                    <Button DockPanel.Dock="Left" Content="▶" Padding="8,2" Margin="0,0,8,0" Click="PlanNextWeek_Click"/>
                    <Button DockPanel.Dock="Left" Content="Today" Padding="8,2" Margin="0,0,0,0" Click="PlanToday_Click"/>
                </DockPanel>

                <!-- Toolbar: add event of currently selected type -->
                <DockPanel Grid.Row="1" Margin="10" LastChildFill="False">
                    <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Type:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="Cb_eventType" DockPanel.Dock="Left" Width="180" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Cb_eventType_SelectionChanged">
                        <ComboBoxItem Content="Fixed appointment"/>
                        <ComboBoxItem Content="Work hours (for tasks)"/>
                        <ComboBoxItem Content="Free time (no tasks)"/>
                        <ComboBoxItem Content="Sleep"/>
                    </ComboBox>

                    <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Title:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="Tb_eventTitle" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center" Padding="4"/>

                    <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="Day:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <DatePicker x:Name="Dp_eventDay" DockPanel.Dock="Left" VerticalAlignment="Center" Width="140"/>

                    <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="From:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="Cb_eventStart" DockPanel.Dock="Left" Width="80" VerticalAlignment="Center"/>
                    <Label Style="{StaticResource Label}" DockPanel.Dock="Left" Content="To:" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <ComboBox x:Name="Cb_eventEnd" DockPanel.Dock="Left" Width="80" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource Border}" DockPanel.Dock="Right" Content="Add event" Padding="14,4" Margin="10,0,0,0" Click="AddCalendarEvent"/>
                </DockPanel>

                <!-- Week overview: 7 columns, one per day -->
                <Grid Grid.Row="2" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Day headers + content generated in code-behind for now.
                         Reason: dynamic time-grid with hour rows is easier to build
                         programmatically than to template. See RefreshPlanView(). -->
                </Grid>
            </Grid>

            <!--Settings-->
            <Grid Grid.Column="1" x:Name="Settings" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Personalize the planner and timer to match how you actually work." Foreground="Gray" FontSize="12" Margin="0,0,0,20"/>

                        <!-- Planner section -->
                        <Border Background="#ffffff" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Planner" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                                <TextBlock Text="How many hours per day are realistic, and how far ahead should the planner look?" Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

                                <TextBlock Text="Max hours per day" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_maxHours" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="3.5h" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_maxHours" Minimum="0.5" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Sl_maxHours_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Plan horizon (days)" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_planableDays" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="10d" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_planableDays" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_planableDays_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Work-day boundaries" Margin="0,0,0,4"/>
                                <TextBlock Text="Tasks are placed only inside this window unless you mark time as Free/Sleep elsewhere." Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Start" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="Cb_workStart" SelectionChanged="Cb_workHours_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="End" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="Cb_workEnd" SelectionChanged="Cb_workHours_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Focus / Timer section -->
                        <Border Background="#ffffff" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Focus timer" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                                <TextBlock Text="Length of one focus block, breaks, and when to take a long one." Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

                                <TextBlock Text="Focus block length" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_focusMin" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="50min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_focusMin" Minimum="15" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Sl_focusMin_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Short break" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_shortBreak" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="5min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_shortBreak" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_shortBreak_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Long break" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_longBreak" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="15min" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_longBreak" Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_longBreak_Changed"/>
                                </DockPanel>

                                <TextBlock Text="Long break every Nth block" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock x:Name="Lbl_blocksBeforeLong" DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="3" VerticalAlignment="Center"/>
                                    <Slider x:Name="Sl_blocksBeforeLong" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sl_blocksBeforeLong_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Appearance section -->
                        <Border Background="#ffffff" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock Text="Dark mode" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="Tg_darkMode" DockPanel.Dock="Right" Content="Off" Width="60" Checked="Tg_darkMode_Changed" Unchecked="Tg_darkMode_Changed"/>
                                </DockPanel>
                                <TextBlock Text="(Not yet implemented in this build — coming soon.)" Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Border>

                        <!-- Data section -->
                        <Border Background="#ffffff" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Data" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                    <TextBlock Text="Save location" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Open folder" Padding="12,4" Click="OpenDataFolder_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="Lbl_dataPath" Text="..." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <TextBlock Text="Export all data (JSON)" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Export" Padding="12,4" Click="ExportData_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="Lbl_exportStatus" Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Background="#ffffff" BorderBrush="#abadb3" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel>
                                <TextBlock Text="About" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock Text="Task Management — A planner that respects your calendar and your time." Margin="0,0,0,4"/>
                                <TextBlock x:Name="Lbl_version" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink x:Name="Link_github" NavigateUri="https://github.com/nico25112005/TaskManagement_App" RequestNavigate="Link_github_RequestNavigate">
                                        github.com/nico25112005/TaskManagement_App
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar: always visible, shows live counts -->
        <Border Grid.Row="2" Background="#ffffff" BorderBrush="#abadb3" BorderThickness="0,1,0,0" Padding="10,4"
                x:Name="StatusBar">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" x:Name="Status_OpenTasks" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="Status_TodayHours" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="Status_FocusBlocks" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,20,0"/>
                <TextBlock x:Name="Status_Message" VerticalAlignment="Center" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
